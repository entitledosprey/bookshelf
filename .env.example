# ─── Admin ───────────────────────────────────────────────────────────────────
# Mints invite codes. Empty => every /api/v1/admin/* route returns 404 and the
# app still runs normally; you just cannot create accounts or trigger syncs.
ADMIN_API_KEY=
SESSION_TTL_DAYS=90
INVITE_TTL_DAYS=14

# ─── Sync ────────────────────────────────────────────────────────────────────
# Per user. All users share ONE polite global fetch queue, so raising this does
# not multiply load against Goodreads.
SYNC_INTERVAL_HOURS=12
# Minimum gap between any two Goodreads requests, across all users.
GOODREADS_MIN_DELAY_MS=1500
# Safety stop so a Goodreads format change cannot page forever. 40 x 200 = 8000.
SYNC_MAX_PAGES=40
# Test-only override. Leave empty in production.
GOODREADS_BASE_URL=

# ─── Enrichment ──────────────────────────────────────────────────────────────
# Empty/false => spines use Goodreads covers + heuristic geometry only.
ENRICH_ENABLED=true
ENRICH_PER_TICK=10
# Optional. Without a key Google Books 429s almost immediately from a cold IP,
# so it gets a long cooldown and Open Library carries the load.
GOOGLE_BOOKS_API_KEY=
# Goes into the User-Agent. Open Library grants identified requests a 3x limit.
CONTACT_EMAIL=
PUBLIC_URL=

# ─── Server ──────────────────────────────────────────────────────────────────
# Empty => same-origin only. Set for native/dev clients.
CORS_ORIGINS=
SECURE_COOKIES=true
PORT=8080
DB_PATH=/app/data/bookshelf.db
COVER_DIR=/app/data/covers
TZ=America/Los_Angeles
